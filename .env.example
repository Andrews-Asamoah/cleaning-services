# AuraClean — environment variables
# Copy to .env.local and fill in. Never commit real values.
# Which phase needs each group is noted; unused groups can stay empty until then.

# ── Core (Phase 0) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database: Neon Postgres, London region (Phase 1) ─────────────────────────
DATABASE_URL=

# ── Better Auth (Phase 1 admin login, Phase 7 customer portal) ───────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Cloudflare R2 file storage for CVs and photos (Phase 1) ──────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Email: Resend (Phase 1) ──────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="AuraClean <hello@auraclean.co.uk>"
EMAIL_TEAM_INBOX=

# ── Bot protection: Cloudflare Turnstile + Upstash rate limiting (Phase 1) ───
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Payments: Stripe (Phase 5) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Monitoring: Sentry (Phase 0 follow-up, once you have a DSN) ──────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
